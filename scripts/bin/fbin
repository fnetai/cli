#!/bin/sh
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  case "$SCRIPT" in /*) ;; *) SCRIPT="$DIR/$SCRIPT" ;; esac
done
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
PKG="$DIR/../.."
BIN="$PKG/bin/fbin"
if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
else
  exec node "$PKG/dist/fbin/index.js" "$@"
fi
